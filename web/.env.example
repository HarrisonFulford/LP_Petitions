# Public testnet RPC used by browser-side wagmi and public-safe API config.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Fill these after Harrison deploys the demo contracts on Base Sepolia.
NEXT_PUBLIC_LP_PETITION_ADDRESS=
NEXT_PUBLIC_MOCK_SPCX_ADDRESS=
NEXT_PUBLIC_MOCK_SPCX_USD_AGGREGATOR_ADDRESS=

# Optional server-only override for receipt verification. Do not expose private RPC keys client-side.
BASE_SEPOLIA_RPC_URL=

# Optional hosted Postgres mirror. When absent, /api/petitions uses in-memory dev storage.
DATABASE_URL=

# F4 price fetching. xStocks docs route public asset price data through Backed's public API.
XSTOCKS_SPCX_PRICE_URL=https://api.backed.fi/api/v2/public/assets/SPCXx/price-data
XSTOCKS_QUOTE_ASSET_URL=https://api.xstocks.fi/api/v1/quotes/assets/SPCXx
# Optional timeout guard so a slow public endpoint cannot stall the demo. Defaults to 4000.
XSTOCKS_FETCH_TIMEOUT_MS=4000
# Optional server-only demo fallback if live xStocks public quotes are closed/null.
# This seeds the mock oracle for local demos; it is not live market data.
SPCX_USD_FALLBACK_PRICE=
