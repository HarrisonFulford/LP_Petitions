# Base Sepolia RPC used by fork tests and deploy scripts.
# Fork tests are skipped (not failed) when this is unset.
# e.g. https://sepolia.base.org  or an Alchemy/Infura/QuickNode endpoint
BASE_SEPOLIA_RPC_URL=

# Deployer key for broadcast scripts (C6). Never commit a funded key.
PRIVATE_KEY=

# Optional: BaseScan API key for contract verification
BASESCAN_API_KEY=
